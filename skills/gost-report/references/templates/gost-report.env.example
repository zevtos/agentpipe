# Subject-уровневый конфиг gost-report (один на курс/предмет).
#
# Положи в корень папки курса:
#   математика/.gost-report.env
#   физика/.gost-report.env
#
# Скилл при запуске build.py идёт вверх по дереву до project root
# (.git / Makefile / pyproject.toml / .claude — первый найденный маркер) и
# применяет ближайший .gost-report.env. В монорепо с несколькими предметами
# это даёт per-subject преподавателя без дублирования.
#
# Что писать сюда: всё специфичное для курса. ФИО студента и группу удобнее
# держать в глобальном ~/.config/gost-report/config — один раз на всю учёбу.
#
# Приоритет (сверху вниз — выигрывает первый непустой):
#   1. реальные env (export GOST_REPORT_…)
#   2. этот файл
#   3. ~/.config/gost-report/config
#   4. TitleConfig(...) в build.py

GOST_REPORT_TEACHER_NAME="Фамилия И.О."
GOST_REPORT_TEACHER_DEGREE="к.т.н."
GOST_REPORT_TEACHER_POSITION="доцент"
GOST_REPORT_TEACHER_LABEL="Проверил"

# Если для конкретного курса нужен необычный факультет — раскомментируй:
# GOST_REPORT_FACULTY="Факультет программной инженерии и компьютерной техники"

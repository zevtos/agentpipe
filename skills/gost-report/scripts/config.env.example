# gost-report — персональный конфиг.
#
# Этот файл копируется install.sh / install.ps1 в
#   ~/.config/gost-report/config         (или $XDG_CONFIG_HOME/gost-report/config)
# при первой установке скилла. Существующий файл НЕ перезаписывается.
#
# Формат: KEY=VALUE построчно, как у обычного .env. Поддерживаются:
#   - кавычки (одинарные/двойные)
#   - `export` (для совместимости с шеллом — необязательно)
#   - комментарии (#)
# Подстановки переменных НЕ работают: $HOME и ${VAR} останутся как есть.
#
# Приоритет (сверху вниз — выигрывает первый непустой источник):
#   1. реальные переменные окружения (export GOST_REPORT_… в .zshrc/.bashrc)
#   2. этот файл
#   3. явный аргумент TitleConfig(...) в build.py
#
# Расположение этого файла можно переопределить через GOST_REPORT_CONFIG.

# --- Студент (одиночная работа) ---
GOST_REPORT_STUDENT_NAME="Фамилия И.О."
GOST_REPORT_STUDENT_GROUP="P3XXX"

# --- Команда (если работа групповая) ---
# Список через запятую. Если задан — перекрывает STUDENT_NAME.
# Авто-меняет "Выполнил" на "Выполнили" (можно переопределить через STUDENT_LABEL).
# GOST_REPORT_STUDENT_NAMES="Иванов И.И., Петров П.П., Сидоров С.С."

# Кастомный label для блока "Выполнил/Выполнила/Выполнили".
# GOST_REPORT_STUDENT_LABEL="Выполнила"

# --- Преподаватель ---
GOST_REPORT_TEACHER_NAME="Фамилия И.О."
GOST_REPORT_TEACHER_DEGREE="к.т.н."
GOST_REPORT_TEACHER_POSITION="доцент"
# "Проверил" по умолчанию. Для женщины — "Проверила". Для ВКР/курсовой — "Руководитель".
GOST_REPORT_TEACHER_LABEL="Проверил"

# --- Год (обычно текущий учебный) ---
GOST_REPORT_YEAR="2026"

# --- Опционально: переопределение полей профиля университета ---
# GOST_REPORT_CITY="Санкт-Петербург"
# GOST_REPORT_UNIVERSITY_SHORT=""
# GOST_REPORT_UNIVERSITY_FULL=""
# GOST_REPORT_FACULTY=""
# GOST_REPORT_MINISTRY=""
